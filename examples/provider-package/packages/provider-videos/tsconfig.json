{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": false,
    "declaration": true, "rootDir": "src", "outDir": "dist", "skipLibCheck": false
  },
  "include": ["src/**/*.ts"]
}
